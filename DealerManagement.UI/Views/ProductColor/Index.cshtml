@{
    ViewData["Title"] = "Product Color";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = "Product Color List",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/ProductColor", "Product Color"},
        {"", "List"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <a href="/ProductColor/Create" class="button NewButton addNewButton">
                <i class="fas fa-plus"></i> New Color
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title">List Of Product Colors</h3>
        </div>
        <div class="card-body">
            <div id="ColorGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var gridDataSource = new kendo.data.DataSource({
                type: "json",
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                pageSize: 10,
                transport: {
                    read: {
                        url: "/ProductColor/GetGridData",
                        type: "POST",
                        dataType: "json",
                        cache: false
                    }
                },
                schema: {
                    data: "items",
                    total: "totalCount",
                    model: {
                        id: "productColorID",
                        fields: {
                            productColorID: { type: "number" },
                            colorName: { type: "string" },
                            colorCode: { type: "string" },
                            isActive: { type: "boolean" }
                        }
                    }
                }
            });

            $("#ColorGrid").kendoGrid({
                dataSource: gridDataSource,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, "all"],
                    buttonCount: 5
                },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        title: "Action",
                        width: "110px",
                        template: function (dataItem) {
                            return `<a href='/ProductColor/Edit/${dataItem.productColorID}' class='btn btn-primary btn-sm mr-1' title='Edit'>
                                        <i class='fas fa-pencil-alt'></i>
                                    </a>
                                    <button type='button' class='btn btn-danger btn-sm' onclick='deleteColor(${dataItem.productColorID})' title='Delete'>
                                        <i class='fas fa-trash'></i>
                                    </button>`;
                        }
                    },
                    { field: "colorName", title: "Color Name", width: "250px" },
                    { 
                        field: "colorCode", 
                        title: "Color Code / Hex", 
                        width: "180px",
                        template: function (dataItem) {
                            if (!dataItem.colorCode) return '';
                            return `<span class='badge' style='background-color:${dataItem.colorCode}; color:#000; border:1px solid #ccc;'>${dataItem.colorCode}</span>`;
                        }
                    },
                    {
                        field: "isActive",
                        title: "Status",
                        width: "120px",
                        template: "#= isActive ? '<span class=\"badge badge-success\">Active</span>' : '<span class=\"badge badge-danger\">Inactive</span>' #"
                    }
                ]
            });
        });

        function deleteColor(id) {
            if (confirm("Are you sure you want to delete this Color?")) {
                $.ajax({
                    url: '/ProductColor/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            $('#ColorGrid').data('kendoGrid').dataSource.read();
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}

