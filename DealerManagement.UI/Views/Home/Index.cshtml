@{
    ViewData["Title"] = "Dashboard";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-tachometer-alt mr-2 text-primary"></i> Dashboard</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Home/Index">Home</a></li>
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Welcome Card -->
    <div class="col-12 mb-3">
        <div class="card card-primary card-outline shadow-sm">
            <div class="card-body">
                <h4><i class="fas fa-hand-wave mr-2 text-warning"></i> Welcome, <strong>@User.Identity?.Name</strong>!</h4>
                <p class="text-muted mb-0">Dealer Management Software is up and running. Follow the sidebar navigation to manage users and access system features.</p>
            </div>
        </div>
    </div>

    <!-- Quick Stat Cards -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info shadow-sm">
            <div class="inner">
                <h3>Users</h3>
                <p>User Management</p>
            </div>
            <div class="icon">
                <i class="fas fa-users"></i>
            </div>
            <a href="/User/Index" class="small-box-footer">
                Manage Users <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-success shadow-sm">
            <div class="inner">
                <h3>35</h3>
                <p>Database Tables</p>
            </div>
            <div class="icon">
                <i class="fas fa-database"></i>
            </div>
            <span class="small-box-footer">
                DealerManagementDB <i class="fas fa-check-circle"></i>
            </span>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning shadow-sm">
            <div class="inner">
                <h3>ADO.NET</h3>
                <p>Database Engine</p>
            </div>
            <div class="icon">
                <i class="fas fa-bolt"></i>
            </div>
            <span class="small-box-footer">
                High Performance & Raw SQL <i class="fas fa-check"></i>
            </span>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger shadow-sm">
            <div class="inner">
                <h3>Kendo UI</h3>
                <p>Grid & Form Controls</p>
            </div>
            <div class="icon">
                <i class="fas fa-table"></i>
            </div>
            <span class="small-box-footer">
                ShampanERP Reused <i class="fas fa-check-circle"></i>
            </span>
        </div>
    </div>
</div>
