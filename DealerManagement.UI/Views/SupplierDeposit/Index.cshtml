@{
    ViewData["Title"] = "Supplier Payment";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = "Supplier Payments / Deposits",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/SupplierDeposit", "Supplier Payment"},
        {"", "List"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <a href="/SupplierDeposit/Create" class="button NewButton addNewButton">
                <i class="fas fa-plus"></i> New Supplier Payment
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title">List Of Supplier Payments</h3>
        </div>
        <div class="card-body">
            <div id="DepositGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var gridDataSource = new kendo.data.DataSource({
                type: "json",
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                pageSize: 10,
                transport: {
                    read: {
                        url: "/SupplierDeposit/GetGridData",
                        type: "POST",
                        dataType: "json"
                    }
                },
                schema: {
                    data: "items",
                    total: "totalCount",
                    model: {
                        id: "supplierDepositID",
                        fields: {
                            supplierDepositID: { type: "number" },
                            depositNo: { type: "string" },
                            supplierName: { type: "string" },
                            depositDate: { type: "date" },
                            amount: { type: "number" },
                            paymentMethod: { type: "string" },
                            referenceNo: { type: "string" },
                            status: { type: "string" }
                        }
                    }
                }
            });

            $("#DepositGrid").kendoGrid({
                dataSource: gridDataSource,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, "all"],
                    buttonCount: 5
                },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        title: "Action",
                        width: "110px",
                        template: function (dataItem) {
                            return `<a href='/SupplierDeposit/Edit/${dataItem.supplierDepositID}' class='btn btn-primary btn-sm mr-1' title='Edit'>
                                        <i class='fas fa-pencil-alt'></i>
                                    </a>
                                    <button type='button' class='btn btn-danger btn-sm' onclick='deleteDeposit(${dataItem.supplierDepositID})' title='Delete'>
                                        <i class='fas fa-trash'></i>
                                    </button>`;
                        }
                    },
                    { field: "depositNo", title: "Payment / Voucher No", width: "170px" },
                    { field: "supplierName", title: "Supplier Name", width: "200px" },
                    { 
                        field: "depositDate", 
                        title: "Date", 
                        width: "120px",
                        template: "#= depositDate ? kendo.toString(kendo.parseDate(depositDate), 'yyyy-MM-dd') : '' #"
                    },
                    { 
                        field: "amount", 
                        title: "Amount Paid", 
                        width: "150px",
                        template: "#= kendo.toString(amount, 'n2') #"
                    },
                    { field: "paymentMethod", title: "Payment Mode", width: "130px" },
                    { field: "referenceNo", title: "Cheque / Ref No", width: "150px" },
                    {
                        field: "status",
                        title: "Status",
                        width: "110px",
                        template: function (dataItem) {
                            var badge = "secondary";
                            if (dataItem.status === "Posted") badge = "success";
                            else if (dataItem.status === "Draft") badge = "info";
                            else if (dataItem.status === "Cancelled") badge = "danger";
                            return `<span class='badge badge-${badge}'>${dataItem.status}</span>`;
                        }
                    }
                ]
            });
        });

        function deleteDeposit(id) {
            if (confirm("Are you sure you want to delete this Payment record?")) {
                $.ajax({
                    url: '/SupplierDeposit/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            $('#DepositGrid').data('kendoGrid').dataSource.read();
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}

