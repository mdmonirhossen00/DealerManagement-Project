@model DealerManagement.Model.Entities.Role
@{
    var isUpdate = Model.Operation == "update";
    ViewData["Title"] = isUpdate ? "Edit Role" : "New Role";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = (isUpdate ? "Edit" : "Create") + " User Role",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/Role", "Role"},
        {"", isUpdate ? "Edit" : "Create"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <button type="button" class="button btnSave @(isUpdate ? "sslUpdate" : "sslSave")" id="btnSaveRole">
                <i class="fas fa-save mr-1"></i> @(isUpdate ? "Update" : "Save")
            </button>
            <a href="/Role/Index" class="btn btn-secondary btn-sm float-right ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Back to List
            </a>
            @if (isUpdate)
            {
                <a href="/RoleMenu/RoleMenuEdit?roleId=@Model.Id" class="btn btn-info btn-sm float-right ml-2">
                    <i class="fas fa-shield-alt mr-1"></i> Assign Menus
                </a>
                <a href="/Role/Create" class="button NewButton addNewButton float-right">
                    <i class="fas fa-plus mr-1"></i> New
                </a>
            }
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-user-shield mr-1"></i> Role Details</h3>
        </div>
        <form id="frmRole">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.Operation)

            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 form-group">
                        @Html.LabelFor(m => m.Name) <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "e.g. SalesManager, Accountant, Dealer", required = "required" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 form-group">
                        @Html.LabelFor(m => m.Description)
                        @Html.TextBoxFor(m => m.Description, new { @class = "form-control", placeholder = "Brief description of role responsibilities" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <div class="custom-control custom-switch mt-2">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "custom-control-input", id = "customSwitchIsActive" })
                            <label class="custom-control-label" for="customSwitchIsActive">Active Role</label>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#btnSaveRole').click(function () {
                var form = $('#frmRole');
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }

                var formData = form.serialize();

                $.ajax({
                    url: '/Role/CreateEdit',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            if ($('#Operation').val() === 'add' && res.data) {
                                $('#Id').val(res.data.id);
                                $('#Operation').val('update');
                                $('#btnSaveRole').html('<i class="fas fa-save mr-1"></i> Update').removeClass('sslSave').addClass('sslUpdate');
                            }
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while saving the Role.");
                    }
                });
            });
        });
    </script>
}

