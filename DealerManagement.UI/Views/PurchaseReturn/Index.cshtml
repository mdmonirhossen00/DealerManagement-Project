@{
    ViewData["Title"] = "Purchase Return";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = "Purchase Return List",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/PurchaseReturn", "Purchase Return"},
        {"", "List"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <a href="/PurchaseReturn/Create" class="button NewButton addNewButton">
                <i class="fas fa-plus"></i> New Purchase Return
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title">List Of Purchase Returns</h3>
        </div>
        <div class="card-body">
            <div id="PurchaseReturnGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var gridDataSource = new kendo.data.DataSource({
                type: "json",
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                pageSize: 10,
                transport: {
                    read: {
                        url: "/PurchaseReturn/GetGridData",
                        type: "POST",
                        dataType: "json"
                    }
                },
                schema: {
                    data: "items",
                    total: "totalCount",
                    model: {
                        id: "purchaseReturnID",
                        fields: {
                            purchaseReturnID: { type: "number" },
                            purchaseReturnNo: { type: "string" },
                            supplierName: { type: "string" },
                            receiptNo: { type: "string" },
                            returnDate: { type: "date" },
                            reason: { type: "string" },
                            totalAmount: { type: "number" },
                            status: { type: "string" }
                        }
                    }
                }
            });

            $("#PurchaseReturnGrid").kendoGrid({
                dataSource: gridDataSource,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, "all"],
                    buttonCount: 5
                },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        title: "Action",
                        width: "110px",
                        template: function (dataItem) {
                            return `<a href='/PurchaseReturn/Edit/${dataItem.purchaseReturnID}' class='btn btn-primary btn-sm mr-1' title='Edit'>
                                        <i class='fas fa-pencil-alt'></i>
                                    </a>
                                    <button type='button' class='btn btn-danger btn-sm' onclick='deleteReturn(${dataItem.purchaseReturnID})' title='Delete'>
                                        <i class='fas fa-trash'></i>
                                    </button>`;
                        }
                    },
                    { field: "purchaseReturnNo", title: "Return No", width: "160px" },
                    { field: "supplierName", title: "Supplier", width: "190px" },
                    { field: "receiptNo", title: "MRR Ref", width: "150px" },
                    { 
                        field: "returnDate", 
                        title: "Return Date", 
                        width: "120px",
                        template: "#= returnDate ? kendo.toString(kendo.parseDate(returnDate), 'yyyy-MM-dd') : '' #"
                    },
                    { field: "reason", title: "Reason", width: "180px" },
                    { 
                        field: "totalAmount", 
                        title: "Total Amount", 
                        width: "140px",
                        template: "#= kendo.toString(totalAmount, 'n2') #"
                    },
                    {
                        field: "status",
                        title: "Status",
                        width: "120px",
                        template: function (dataItem) {
                            var badge = "secondary";
                            if (dataItem.status === "Approved") badge = "primary";
                            else if (dataItem.status === "Dispatched") badge = "success";
                            else if (dataItem.status === "Cancelled") badge = "danger";
                            return `<span class='badge badge-${badge}'>${dataItem.status}</span>`;
                        }
                    }
                ]
            });
        });

        function deleteReturn(id) {
            if (confirm("Are you sure you want to delete this Purchase Return?")) {
                $.ajax({
                    url: '/PurchaseReturn/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            $('#PurchaseReturnGrid').data('kendoGrid').dataSource.read();
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}

