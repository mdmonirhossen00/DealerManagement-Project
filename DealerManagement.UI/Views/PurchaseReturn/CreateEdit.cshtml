@model DealerManagement.Model.Entities.PurchaseReturnMaster
@{
    var isUpdate = Model.Operation == "update";
    ViewData["Title"] = isUpdate ? "Edit Purchase Return" : "New Purchase Return";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = (isUpdate ? "Edit" : "Create") + " Purchase Return",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/PurchaseReturn", "Purchase Return"},
        {"", isUpdate ? "Edit" : "Create"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <button type="button" class="button btnSave @(isUpdate ? "sslUpdate" : "sslSave")" id="btnSaveReturn">
                <i class="fas fa-save mr-1"></i> @(isUpdate ? "Update" : "Save")
            </button>
            <a href="/PurchaseReturn/Index" class="btn btn-secondary btn-sm float-right ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Back to List
            </a>
            @if (isUpdate)
            {
                <a href="/PurchaseReturn/Create" class="button NewButton addNewButton float-right">
                    <i class="fas fa-plus mr-1"></i> New
                </a>
            }
        </div>
    </div>
</div>

<form id="frmReturnMaster">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.PurchaseReturnID)
    @Html.HiddenFor(m => m.Operation)

    <div class="container-fluid">
        <!-- Master Form Card -->
        <div class="card card-secondary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-truck-loading mr-1"></i> Purchase Return Master</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 form-group">
                        @Html.LabelFor(m => m.PurchaseReturnNo) <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.PurchaseReturnNo, new { @class = "form-control form-control-sm", required = "required" })
                        @Html.ValidationMessageFor(m => m.PurchaseReturnNo, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3 form-group">
                        <label>Supplier <span class="text-danger">*</span></label>
                        <select id="SupplierID" name="SupplierID" class="form-control form-control-sm" data-selected="@Model.SupplierID" required>
                            <option value="">----- Select Supplier -----</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.SupplierID, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3 form-group">
                        <label>MRR / Receipt Ref</label>
                        <select id="PurchaseReceiptID" name="PurchaseReceiptID" class="form-control form-control-sm" data-selected="@Model.PurchaseReceiptID">
                            <option value="">----- Direct / Select Receipt -----</option>
                        </select>
                    </div>

                    <div class="col-md-3 form-group">
                        @Html.LabelFor(m => m.ReturnDate) <span class="text-danger">*</span>
                        <input type="date" id="ReturnDate" name="ReturnDate" class="form-control form-control-sm" value="@Model.ReturnDate.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.Status)
                        <select id="Status" name="Status" class="form-control form-control-sm">
                            <option value="Draft" selected="@(Model.Status == "Draft")">Draft</option>
                            <option value="Approved" selected="@(Model.Status == "Approved")">Approved</option>
                            <option value="Dispatched" selected="@(Model.Status == "Dispatched")">Dispatched</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-md-8 form-group">
                        @Html.LabelFor(m => m.Reason)
                        @Html.TextBoxFor(m => m.Reason, new { @class = "form-control form-control-sm", placeholder = "Return reason / description" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Section Card -->
        <div class="card card-secondary">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title"><i class="fas fa-boxes mr-1"></i> Returned Items</h3>
                <button type="button" id="btnAddRow" class="btn btn-success btn-sm float-right">
                    <i class="fas fa-plus mr-1"></i> Add Item
                </button>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered table-striped table-sm mb-0" id="tblReturnDetails">
                    <thead class="bg-light">
                        <tr>
                            <th style="width: 35%;">Product / Item <span class="text-danger">*</span></th>
                            <th style="width: 15%; text-align: right;">Quantity <span class="text-danger">*</span></th>
                            <th style="width: 15%; text-align: right;">Unit Price <span class="text-danger">*</span></th>
                            <th style="width: 15%; text-align: right;">Line Total</th>
                            <th style="width: 15%;">Item Reason</th>
                            <th style="width: 5%; text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblReturnDetailsBody">
                        @if (Model.DetailsList != null && Model.DetailsList.Any())
                        {
                            foreach (var line in Model.DetailsList)
                            {
                                <tr class="item-row">
                                    <td>
                                        <select class="form-control form-control-sm ddlProduct" required data-selected="@line.ProductID">
                                            <option value="">----- Select Product -----</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="any" min="0.001" class="form-control form-control-sm text-right txtQty" value="@line.Quantity" required />
                                    </td>
                                    <td>
                                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtPrice" value="@line.UnitPrice" required />
                                    </td>
                                    <td>
                                        <input type="number" step="any" class="form-control form-control-sm text-right txtLineTotal bg-light" value="@(line.Quantity * line.UnitPrice)" readonly />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm txtItemReason" value="@line.Reason" placeholder="Reason" />
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-danger btn-sm btnRemoveRow" title="Remove"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="bg-light font-weight-bold">
                        <tr>
                            <td class="text-right">Grand Total:</td>
                            <td class="text-right"><span id="lblTotalQty">0.00</span></td>
                            <td></td>
                            <td class="text-right"><span id="lblGrandTotal">0.00</span></td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/CommonComboLoader.js"></script>
    <script>
        var productListOptions = [];

        $(document).ready(function () {
            // Load Suppliers
            LoadCombo("SupplierID", '/Common/GetSuppliers');
            var selSupp = $('#SupplierID').attr('data-selected');
            if (selSupp && selSupp > 0) {
                $('#SupplierID').val(selSupp);
                LoadCombo("PurchaseReceiptID", '/Common/GetPurchaseReceipts?supplierId=' + selSupp);
            }

            $('#SupplierID').change(function () {
                var sId = $(this).val();
                LoadCombo("PurchaseReceiptID", '/Common/GetPurchaseReceipts?supplierId=' + (sId || 0));
            });

            var selRcpt = $('#PurchaseReceiptID').attr('data-selected');
            if (selRcpt && selRcpt > 0) {
                $('#PurchaseReceiptID').val(selRcpt);
            }

            // Cache products list
            $.ajax({
                url: '/Common/GetProducts',
                type: 'GET',
                async: false,
                success: function (data) {
                    productListOptions = data;
                }
            });

            $('#tblReturnDetailsBody tr').each(function () {
                var ddl = $(this).find('.ddlProduct');
                populateProductDropdown(ddl);
                var sel = ddl.attr('data-selected');
                if (sel && sel > 0) {
                    ddl.val(sel);
                }
            });

            if ($('#tblReturnDetailsBody tr').length === 0) {
                addNewRow();
            }

            calculateTotals();

            $('#btnAddRow').click(function () {
                addNewRow();
            });

            $(document).on('click', '.btnRemoveRow', function () {
                if ($('#tblReturnDetailsBody tr').length > 1) {
                    $(this).closest('tr').remove();
                    calculateTotals();
                } else {
                    toastr.warning("At least one item line is required.");
                }
            });

            $(document).on('change', '.ddlProduct', function () {
                var row = $(this).closest('tr');
                var productId = $(this).val();
                if (productId && productId > 0) {
                    $.ajax({
                        url: '/Common/GetProductPrice?productId=' + productId + '&priceType=Purchase',
                        type: 'GET',
                        success: function (res) {
                            if (res && res.price) {
                                row.find('.txtPrice').val(res.price);
                            }
                            recalculateRow(row);
                        }
                    });
                }
            });

            $(document).on('input', '.txtQty, .txtPrice', function () {
                var row = $(this).closest('tr');
                recalculateRow(row);
            });

            // Save Master & Details
            $('#btnSaveReturn').click(function () {
                var form = $('#frmReturnMaster');
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }

                var details = [];
                var isValid = true;

                $('#tblReturnDetailsBody tr').each(function () {
                    var prodId = $(this).find('.ddlProduct').val();
                    var qty = parseFloat($(this).find('.txtQty').val()) || 0;
                    var price = parseFloat($(this).find('.txtPrice').val()) || 0;
                    var rsn = $(this).find('.txtItemReason').val();

                    if (!prodId || prodId <= 0) {
                        toastr.error("Please select a product for all item rows.");
                        isValid = false;
                        return false;
                    }

                    if (qty <= 0) {
                        toastr.error("Quantity must be greater than zero for all rows.");
                        isValid = false;
                        return false;
                    }

                    details.push({
                        ProductID: parseInt(prodId),
                        Quantity: qty,
                        UnitPrice: price,
                        Reason: rsn
                    });
                });

                if (!isValid) return;

                if (details.length === 0) {
                    toastr.error("Please add at least one item line.");
                    return;
                }

                var receiptIdVal = $('#PurchaseReceiptID').val();

                var masterData = {
                    PurchaseReturnID: parseInt($('#PurchaseReturnID').val()) || 0,
                    PurchaseReturnNo: $('#PurchaseReturnNo').val(),
                    SupplierID: parseInt($('#SupplierID').val()),
                    PurchaseReceiptID: (receiptIdVal && receiptIdVal > 0) ? parseInt(receiptIdVal) : null,
                    ReturnDate: $('#ReturnDate').val(),
                    Reason: $('#Reason').val(),
                    Status: $('#Status').val(),
                    Operation: $('#Operation').val(),
                    DetailsList: details
                };

                $.ajax({
                    url: '/PurchaseReturn/CreateEdit',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(masterData),
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            if ($('#Operation').val() === 'add' && res.data) {
                                $('#PurchaseReturnID').val(res.data.purchaseReturnID);
                                $('#Operation').val('update');
                                $('#btnSaveReturn').html('<i class="fas fa-save mr-1"></i> Update').removeClass('sslSave').addClass('sslUpdate');
                            }
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An unexpected error occurred while saving.");
                    }
                });
            });
        });

        function populateProductDropdown(ddl) {
            ddl.empty();
            ddl.append(new Option("----- Select Product -----", ""));
            $.each(productListOptions, function (i, item) {
                ddl.append(new Option(item.value, item.name));
            });
        }

        function addNewRow() {
            var tr = $(`
                <tr class="item-row">
                    <td>
                        <select class="form-control form-control-sm ddlProduct" required>
                            <option value="">----- Select Product -----</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" step="any" min="0.001" class="form-control form-control-sm text-right txtQty" value="1" required />
                    </td>
                    <td>
                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtPrice" value="0.00" required />
                    </td>
                    <td>
                        <input type="number" step="any" class="form-control form-control-sm text-right txtLineTotal bg-light" value="0.00" readonly />
                    </td>
                    <td>
                        <input type="text" class="form-control form-control-sm txtItemReason" placeholder="Reason" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm btnRemoveRow" title="Remove"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>
            `);

            populateProductDropdown(tr.find('.ddlProduct'));
            $('#tblReturnDetailsBody').append(tr);
            recalculateRow(tr);
        }

        function recalculateRow(row) {
            var qty = parseFloat(row.find('.txtQty').val()) || 0;
            var price = parseFloat(row.find('.txtPrice').val()) || 0;

            var lineTotal = qty * price;
            row.find('.txtLineTotal').val(lineTotal.toFixed(2));

            calculateTotals();
        }

        function calculateTotals() {
            var totalQty = 0;
            var grandTotal = 0;

            $('#tblReturnDetailsBody tr').each(function () {
                totalQty += parseFloat($(this).find('.txtQty').val()) || 0;
                grandTotal += parseFloat($(this).find('.txtLineTotal').val()) || 0;
            });

            $('#lblTotalQty').text(totalQty.toFixed(2));
            $('#lblGrandTotal').text(grandTotal.toFixed(2));
        }
    </script>
}

