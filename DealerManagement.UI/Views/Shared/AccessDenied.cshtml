@{
    ViewData["Title"] = "Access Denied";
}

<div class="container-fluid pt-4">
    <div class="error-page text-center">
        <h2 class="headline text-danger font-weight-bold"><i class="fas fa-ban"></i> 403</h2>
        <div class="error-content" style="margin-left: 0;">
            <h3><i class="fas fa-exclamation-triangle text-danger"></i> Oops! Access Denied.</h3>
            <p class="lead">
                You do not have permission to access this module or page based on your assigned Role.
            </p>
            <p>
                If you believe you need access to this feature, please contact your system administrator to assign the appropriate Role Menu permissions.
            </p>
            <div class="mt-4">
                <a href="/Home/Index" class="btn btn-primary">
                    <i class="fas fa-tachometer-alt mr-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

