@{
    ViewData["Title"] = "Customer Order";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = "Customer Order List",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/CustomerOrder", "Customer Order"},
        {"", "List"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <a href="/CustomerOrder/Create" class="button NewButton addNewButton">
                <i class="fas fa-plus"></i> New Customer Order
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title">List Of Sales / Customer Orders</h3>
        </div>
        <div class="card-body">
            <div id="SOGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var gridDataSource = new kendo.data.DataSource({
                type: "json",
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                pageSize: 10,
                transport: {
                    read: {
                        url: "/CustomerOrder/GetGridData",
                        type: "POST",
                        dataType: "json"
                    }
                },
                schema: {
                    data: "items",
                    total: "totalCount",
                    model: {
                        id: "customerOrderID",
                        fields: {
                            customerOrderID: { type: "number" },
                            customerOrderNo: { type: "string" },
                            customerName: { type: "string" },
                            orderDate: { type: "date" },
                            requiredDate: { type: "date" },
                            customerReference: { type: "string" },
                            totalAmount: { type: "number" },
                            status: { type: "string" }
                        }
                    }
                }
            });

            $("#SOGrid").kendoGrid({
                dataSource: gridDataSource,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, "all"],
                    buttonCount: 5
                },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        title: "Action",
                        width: "110px",
                        template: function (dataItem) {
                            return `<a href='/CustomerOrder/Edit/${dataItem.customerOrderID}' class='btn btn-primary btn-sm mr-1' title='Edit'>
                                        <i class='fas fa-pencil-alt'></i>
                                    </a>
                                    <button type='button' class='btn btn-danger btn-sm' onclick='deleteSO(${dataItem.customerOrderID})' title='Delete'>
                                        <i class='fas fa-trash'></i>
                                    </button>`;
                        }
                    },
                    { field: "customerOrderNo", title: "Order No", width: "160px" },
                    { field: "customerName", title: "Customer / Dealer", width: "200px" },
                    { 
                        field: "orderDate", 
                        title: "Order Date", 
                        width: "120px",
                        template: "#= orderDate ? kendo.toString(kendo.parseDate(orderDate), 'yyyy-MM-dd') : '' #"
                    },
                    { 
                        field: "requiredDate", 
                        title: "Required Date", 
                        width: "120px",
                        template: "#= requiredDate ? kendo.toString(kendo.parseDate(requiredDate), 'yyyy-MM-dd') : '' #"
                    },
                    { field: "customerReference", title: "PO Ref", width: "130px" },
                    { 
                        field: "totalAmount", 
                        title: "Total Amount", 
                        width: "140px",
                        template: "#= kendo.toString(totalAmount, 'n2') #"
                    },
                    {
                        field: "status",
                        title: "Status",
                        width: "130px",
                        template: function (dataItem) {
                            var badge = "secondary";
                            if (dataItem.status === "Approved") badge = "primary";
                            else if (dataItem.status === "Completed") badge = "success";
                            else if (dataItem.status === "PartiallyDelivered") badge = "info";
                            else if (dataItem.status === "Cancelled") badge = "danger";
                            return `<span class='badge badge-${badge}'>${dataItem.status}</span>`;
                        }
                    }
                ]
            });
        });

        function deleteSO(id) {
            if (confirm("Are you sure you want to delete this Customer Order?")) {
                $.ajax({
                    url: '/CustomerOrder/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            $('#SOGrid').data('kendoGrid').dataSource.read();
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}

