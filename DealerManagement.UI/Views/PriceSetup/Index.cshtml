@{
    ViewData["Title"] = "Price Setup";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = "Price Setup List",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/PriceSetup", "Price Setup"},
        {"", "List"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <a href="/PriceSetup/Create" class="button NewButton addNewButton">
                <i class="fas fa-plus"></i> New Price Rule
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title">List Of Product Prices</h3>
        </div>
        <div class="card-body">
            <div id="PriceSetupGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var gridDataSource = new kendo.data.DataSource({
                type: "json",
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                pageSize: 10,
                transport: {
                    read: {
                        url: "/PriceSetup/GetGridData",
                        type: "POST",
                        dataType: "json"
                    }
                },
                schema: {
                    data: "items",
                    total: "totalCount",
                    model: {
                        id: "priceSetupID",
                        fields: {
                            priceSetupID: { type: "number" },
                            productCode: { type: "string" },
                            productNameText: { type: "string" },
                            priceType: { type: "string" },
                            unitPrice: { type: "number" },
                            unitName: { type: "string" },
                            effectiveFrom: { type: "date" },
                            effectiveTo: { type: "date" },
                            isActive: { type: "boolean" }
                        }
                    }
                }
            });

            $("#PriceSetupGrid").kendoGrid({
                dataSource: gridDataSource,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, "all"],
                    buttonCount: 5
                },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        title: "Action",
                        width: "110px",
                        template: function (dataItem) {
                            return `<a href='/PriceSetup/Edit/${dataItem.priceSetupID}' class='btn btn-primary btn-sm mr-1' title='Edit'>
                                        <i class='fas fa-pencil-alt'></i>
                                    </a>
                                    <button type='button' class='btn btn-danger btn-sm' onclick='deletePrice(${dataItem.priceSetupID})' title='Delete'>
                                        <i class='fas fa-trash'></i>
                                    </button>`;
                        }
                    },
                    { field: "productCode", title: "Product Code", width: "130px" },
                    { field: "productNameText", title: "Product Name", width: "200px" },
                    { field: "priceType", title: "Price Type", width: "120px" },
                    { 
                        field: "unitPrice", 
                        title: "Unit Price", 
                        width: "120px", 
                        template: "#= kendo.toString(unitPrice, 'n2') #" 
                    },
                    { field: "unitName", title: "Unit", width: "80px" },
                    { 
                        field: "effectiveFrom", 
                        title: "Effective From", 
                        width: "130px", 
                        template: "#= effectiveFrom ? kendo.toString(kendo.parseDate(effectiveFrom), 'yyyy-MM-dd') : '' #" 
                    },
                    { 
                        field: "effectiveTo", 
                        title: "Effective To", 
                        width: "130px", 
                        template: "#= effectiveTo ? kendo.toString(kendo.parseDate(effectiveTo), 'yyyy-MM-dd') : 'Open' #" 
                    },
                    {
                        field: "isActive",
                        title: "Status",
                        width: "100px",
                        template: function (dataItem) {
                            return dataItem.isActive 
                                ? "<span class='badge badge-success'>Active</span>" 
                                : "<span class='badge badge-danger'>Inactive</span>";
                        }
                    }
                ]
            });
        });

        function deletePrice(id) {
            if (confirm("Are you sure you want to delete this Price Setup?")) {
                $.ajax({
                    url: '/PriceSetup/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            $('#PriceSetupGrid').data('kendoGrid').dataSource.read();
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}

