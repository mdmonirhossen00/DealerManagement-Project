@{
    ViewData["Title"] = "Customer Delivery";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = "Delivery Challan List",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/CustomerDelivery", "Delivery Challan"},
        {"", "List"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <a href="/CustomerDelivery/Create" class="button NewButton addNewButton">
                <i class="fas fa-plus"></i> New Delivery Challan
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title">List Of Delivery Challans</h3>
        </div>
        <div class="card-body">
            <div id="DeliveryGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var gridDataSource = new kendo.data.DataSource({
                type: "json",
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                pageSize: 10,
                transport: {
                    read: {
                        url: "/CustomerDelivery/GetGridData",
                        type: "POST",
                        dataType: "json"
                    }
                },
                schema: {
                    data: "items",
                    total: "totalCount",
                    model: {
                        id: "customerDeliveryID",
                        fields: {
                            customerDeliveryID: { type: "number" },
                            deliveryNo: { type: "string" },
                            customerName: { type: "string" },
                            customerOrderNo: { type: "string" },
                            deliveryDate: { type: "date" },
                            vehicleNo: { type: "string" },
                            driverName: { type: "string" },
                            totalAmount: { type: "number" },
                            status: { type: "string" }
                        }
                    }
                }
            });

            $("#DeliveryGrid").kendoGrid({
                dataSource: gridDataSource,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, "all"],
                    buttonCount: 5
                },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        title: "Action",
                        width: "110px",
                        template: function (dataItem) {
                            return `<a href='/CustomerDelivery/Edit/${dataItem.customerDeliveryID}' class='btn btn-primary btn-sm mr-1' title='Edit'>
                                        <i class='fas fa-pencil-alt'></i>
                                    </a>
                                    <button type='button' class='btn btn-danger btn-sm' onclick='deleteDelivery(${dataItem.customerDeliveryID})' title='Delete'>
                                        <i class='fas fa-trash'></i>
                                    </button>`;
                        }
                    },
                    { field: "deliveryNo", title: "Challan No", width: "160px" },
                    { field: "customerName", title: "Customer / Dealer", width: "190px" },
                    { field: "customerOrderNo", title: "Order Ref", width: "150px" },
                    { 
                        field: "deliveryDate", 
                        title: "Delivery Date", 
                        width: "120px",
                        template: "#= deliveryDate ? kendo.toString(kendo.parseDate(deliveryDate), 'yyyy-MM-dd') : '' #"
                    },
                    { field: "vehicleNo", title: "Vehicle No", width: "120px" },
                    { field: "driverName", title: "Driver", width: "130px" },
                    { 
                        field: "totalAmount", 
                        title: "Total Amount", 
                        width: "140px",
                        template: "#= kendo.toString(totalAmount, 'n2') #"
                    },
                    {
                        field: "status",
                        title: "Status",
                        width: "120px",
                        template: function (dataItem) {
                            var badge = "secondary";
                            if (dataItem.status === "Dispatched") badge = "info";
                            else if (dataItem.status === "Delivered") badge = "success";
                            else if (dataItem.status === "Cancelled") badge = "danger";
                            return `<span class='badge badge-${badge}'>${dataItem.status}</span>`;
                        }
                    }
                ]
            });
        });

        function deleteDelivery(id) {
            if (confirm("Are you sure you want to delete this Delivery Challan?")) {
                $.ajax({
                    url: '/CustomerDelivery/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            $('#DeliveryGrid').data('kendoGrid').dataSource.read();
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}

