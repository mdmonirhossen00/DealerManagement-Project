@model DealerManagement.Model.Entities.ProductionMaster
@{
    var isUpdate = Model.Operation == "update";
    ViewData["Title"] = isUpdate ? "Edit Production Entry" : "New Production Entry";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = (isUpdate ? "Edit" : "Create") + " Production Entry",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/Production", "Production"},
        {"", isUpdate ? "Edit" : "Create"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <button type="button" class="button btnSave @(isUpdate ? "sslUpdate" : "sslSave")" id="btnSaveProd">
                <i class="fas fa-save mr-1"></i> @(isUpdate ? "Update" : "Save")
            </button>
            <a href="/Production/Index" class="btn btn-secondary btn-sm float-right ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Back to List
            </a>
            @if (isUpdate)
            {
                <a href="/Production/Create" class="button NewButton addNewButton float-right">
                    <i class="fas fa-plus mr-1"></i> New
                </a>
            }
        </div>
    </div>
</div>

<form id="frmProdMaster">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ProductionID)
    @Html.HiddenFor(m => m.Operation)

    <div class="container-fluid">
        <!-- Master Form Card -->
        <div class="card card-secondary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-industry mr-1"></i> Production Batch Master</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 form-group">
                        @Html.LabelFor(m => m.ProductionNo) <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.ProductionNo, new { @class = "form-control form-control-sm", required = "required" })
                        @Html.ValidationMessageFor(m => m.ProductionNo, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3 form-group">
                        @Html.LabelFor(m => m.ProductionDate) <span class="text-danger">*</span>
                        <input type="date" id="ProductionDate" name="ProductionDate" class="form-control form-control-sm" value="@Model.ProductionDate.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="col-md-3 form-group">
                        <label>Supervisor / Shift Incharge</label>
                        @Html.TextBoxFor(m => m.CreatedBy, new { @class = "form-control form-control-sm", placeholder = "Supervisor Name" })
                    </div>

                    <div class="col-md-3 form-group">
                        @Html.LabelFor(m => m.Status)
                        <select id="Status" name="Status" class="form-control form-control-sm">
                            <option value="Posted" selected="@(Model.Status == "Posted")">Posted</option>
                            <option value="Draft" selected="@(Model.Status == "Draft")">Draft</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 form-group mb-0">
                        @Html.LabelFor(m => m.Remarks)
                        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control form-control-sm", placeholder = "Production notes, batch details, plant info" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Section Card -->
        <div class="card card-secondary">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title"><i class="fas fa-boxes mr-1"></i> Produced Finished Goods</h3>
                <button type="button" id="btnAddRow" class="btn btn-success btn-sm float-right">
                    <i class="fas fa-plus mr-1"></i> Add Finished Good
                </button>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered table-striped table-sm mb-0" id="tblProdDetails">
                    <thead class="bg-light">
                        <tr>
                            <th style="width: 45%;">Finished Product / Item <span class="text-danger">*</span></th>
                            <th style="width: 15%; text-align: right;">Output Quantity <span class="text-danger">*</span></th>
                            <th style="width: 15%; text-align: right;">Unit Cost (Tk)</th>
                            <th style="width: 20%;">Item Remarks</th>
                            <th style="width: 5%; text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblProdDetailsBody">
                        @if (Model.DetailsList != null && Model.DetailsList.Any())
                        {
                            foreach (var line in Model.DetailsList)
                            {
                                <tr class="item-row">
                                    <td>
                                        <select class="form-control form-control-sm ddlProduct" required data-selected="@line.ProductID">
                                            <option value="">----- Select Product -----</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="any" min="0.001" class="form-control form-control-sm text-right txtQty" value="@line.Quantity" required />
                                    </td>
                                    <td>
                                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtCost" value="@(line.UnitCost ?? 0)" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm txtItemRemarks" value="@line.Remarks" placeholder="Remarks" />
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-danger btn-sm btnRemoveRow" title="Remove"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="bg-light font-weight-bold">
                        <tr>
                            <td class="text-right">Total Output Quantity:</td>
                            <td class="text-right"><span id="lblTotalQty">0.00</span></td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        var productListOptions = [];

        $(document).ready(function () {
            // Cache products list
            $.ajax({
                url: '/Common/GetProducts',
                type: 'GET',
                async: false,
                success: function (data) {
                    productListOptions = data;
                }
            });

            $('#tblProdDetailsBody tr').each(function () {
                var ddl = $(this).find('.ddlProduct');
                populateProductDropdown(ddl);
                var sel = ddl.attr('data-selected');
                if (sel && sel > 0) {
                    ddl.val(sel);
                }
            });

            if ($('#tblProdDetailsBody tr').length === 0) {
                addNewRow();
            }

            calculateTotals();

            $('#btnAddRow').click(function () {
                addNewRow();
            });

            $(document).on('click', '.btnRemoveRow', function () {
                if ($('#tblProdDetailsBody tr').length > 1) {
                    $(this).closest('tr').remove();
                    calculateTotals();
                } else {
                    toastr.warning("At least one item line is required.");
                }
            });

            $(document).on('input', '.txtQty', function () {
                calculateTotals();
            });

            // Save Master & Details
            $('#btnSaveProd').click(function () {
                var form = $('#frmProdMaster');
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }

                var details = [];
                var isValid = true;

                $('#tblProdDetailsBody tr').each(function () {
                    var prodId = $(this).find('.ddlProduct').val();
                    var qty = parseFloat($(this).find('.txtQty').val()) || 0;
                    var cost = parseFloat($(this).find('.txtCost').val()) || 0;
                    var rem = $(this).find('.txtItemRemarks').val();

                    if (!prodId || prodId <= 0) {
                        toastr.error("Please select a product for all item rows.");
                        isValid = false;
                        return false;
                    }

                    if (qty <= 0) {
                        toastr.error("Quantity must be greater than zero for all rows.");
                        isValid = false;
                        return false;
                    }

                    details.push({
                        ProductID: parseInt(prodId),
                        Quantity: qty,
                        UnitCost: cost,
                        Remarks: rem
                    });
                });

                if (!isValid) return;

                if (details.length === 0) {
                    toastr.error("Please add at least one item line.");
                    return;
                }

                var masterData = {
                    ProductionID: parseInt($('#ProductionID').val()) || 0,
                    ProductionNo: $('#ProductionNo').val(),
                    ProductionDate: $('#ProductionDate').val(),
                    Remarks: $('#Remarks').val(),
                    Status: $('#Status').val(),
                    CreatedBy: $('#CreatedBy').val(),
                    Operation: $('#Operation').val(),
                    DetailsList: details
                };

                $.ajax({
                    url: '/Production/CreateEdit',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(masterData),
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            if ($('#Operation').val() === 'add' && res.data) {
                                $('#ProductionID').val(res.data.productionID);
                                $('#Operation').val('update');
                                $('#btnSaveProd').html('<i class="fas fa-save mr-1"></i> Update').removeClass('sslSave').addClass('sslUpdate');
                            }
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An unexpected error occurred while saving.");
                    }
                });
            });
        });

        function populateProductDropdown(ddl) {
            ddl.empty();
            ddl.append(new Option("----- Select Product -----", ""));
            $.each(productListOptions, function (i, item) {
                ddl.append(new Option(item.value, item.name));
            });
        }

        function addNewRow() {
            var tr = $(`
                <tr class="item-row">
                    <td>
                        <select class="form-control form-control-sm ddlProduct" required>
                            <option value="">----- Select Product -----</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" step="any" min="0.001" class="form-control form-control-sm text-right txtQty" value="1" required />
                    </td>
                    <td>
                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtCost" value="0.00" />
                    </td>
                    <td>
                        <input type="text" class="form-control form-control-sm txtItemRemarks" placeholder="Remarks" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm btnRemoveRow" title="Remove"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>
            `);

            populateProductDropdown(tr.find('.ddlProduct'));
            $('#tblProdDetailsBody').append(tr);
            calculateTotals();
        }

        function calculateTotals() {
            var totalQty = 0;
            $('#tblProdDetailsBody tr').each(function () {
                totalQty += parseFloat($(this).find('.txtQty').val()) || 0;
            });
            $('#lblTotalQty').text(totalQty.toFixed(2));
        }
    </script>
}

