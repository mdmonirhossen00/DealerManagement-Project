@{
    ViewData["Title"] = "Supplier Setup";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = "Supplier List",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/Supplier", "Supplier"},
        {"", "List"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <a href="/Supplier/Create" class="button NewButton addNewButton">
                <i class="fas fa-plus"></i> New Supplier
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title">List Of Suppliers</h3>
        </div>
        <div class="card-body">
            <div id="SupplierGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var gridDataSource = new kendo.data.DataSource({
                type: "json",
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                pageSize: 10,
                transport: {
                    read: {
                        url: "/Supplier/GetGridData",
                        type: "POST",
                        dataType: "json"
                    }
                },
                schema: {
                    data: "items",
                    total: "totalCount",
                    model: {
                        id: "supplierID",
                        fields: {
                            supplierID: { type: "number" },
                            supplierCode: { type: "string" },
                            supplierName: { type: "string" },
                            contactPerson: { type: "string" },
                            phone: { type: "string" },
                            email: { type: "string" },
                            taxRegistrationNo: { type: "string" },
                            isActive: { type: "boolean" }
                        }
                    }
                }
            });

            $("#SupplierGrid").kendoGrid({
                dataSource: gridDataSource,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, "all"],
                    buttonCount: 5
                },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        title: "Action",
                        width: "110px",
                        template: function (dataItem) {
                            return `<a href='/Supplier/Edit/${dataItem.supplierID}' class='btn btn-primary btn-sm mr-1' title='Edit'>
                                        <i class='fas fa-pencil-alt'></i>
                                    </a>
                                    <button type='button' class='btn btn-danger btn-sm' onclick='deleteSupplier(${dataItem.supplierID})' title='Delete'>
                                        <i class='fas fa-trash'></i>
                                    </button>`;
                        }
                    },
                    { field: "supplierCode", title: "Code", width: "130px" },
                    { field: "supplierName", title: "Supplier Name", width: "220px" },
                    { field: "contactPerson", title: "Contact Person", width: "150px" },
                    { field: "phone", title: "Phone", width: "130px" },
                    { field: "email", title: "Email", width: "180px" },
                    { field: "taxRegistrationNo", title: "Tax / BIN No", width: "140px" },
                    {
                        field: "isActive",
                        title: "Status",
                        width: "100px",
                        template: function (dataItem) {
                            return dataItem.isActive 
                                ? "<span class='badge badge-success'>Active</span>" 
                                : "<span class='badge badge-danger'>Inactive</span>";
                        }
                    }
                ]
            });
        });

        function deleteSupplier(id) {
            if (confirm("Are you sure you want to delete this Supplier?")) {
                $.ajax({
                    url: '/Supplier/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            $('#SupplierGrid').data('kendoGrid').dataSource.read();
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}

