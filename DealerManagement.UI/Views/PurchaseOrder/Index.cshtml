@{
    ViewData["Title"] = "Purchase Order";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = "Purchase Order List",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/PurchaseOrder", "Purchase Order"},
        {"", "List"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <a href="/PurchaseOrder/Create" class="button NewButton addNewButton">
                <i class="fas fa-plus"></i> New Purchase Order
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title">List Of Purchase Orders</h3>
        </div>
        <div class="card-body">
            <div id="POGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var gridDataSource = new kendo.data.DataSource({
                type: "json",
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                pageSize: 10,
                transport: {
                    read: {
                        url: "/PurchaseOrder/GetGridData",
                        type: "POST",
                        dataType: "json"
                    }
                },
                schema: {
                    data: "items",
                    total: "totalCount",
                    model: {
                        id: "purchaseOrderID",
                        fields: {
                            purchaseOrderID: { type: "number" },
                            purchaseOrderNo: { type: "string" },
                            supplierName: { type: "string" },
                            orderDate: { type: "date" },
                            expectedDate: { type: "date" },
                            totalAmount: { type: "number" },
                            status: { type: "string" }
                        }
                    }
                }
            });

            $("#POGrid").kendoGrid({
                dataSource: gridDataSource,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, "all"],
                    buttonCount: 5
                },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        title: "Action",
                        width: "110px",
                        template: function (dataItem) {
                            return `<a href='/PurchaseOrder/Edit/${dataItem.purchaseOrderID}' class='btn btn-primary btn-sm mr-1' title='Edit'>
                                        <i class='fas fa-pencil-alt'></i>
                                    </a>
                                    <button type='button' class='btn btn-danger btn-sm' onclick='deletePO(${dataItem.purchaseOrderID})' title='Delete'>
                                        <i class='fas fa-trash'></i>
                                    </button>`;
                        }
                    },
                    { field: "purchaseOrderNo", title: "PO Number", width: "160px" },
                    { field: "supplierName", title: "Supplier", width: "200px" },
                    { 
                        field: "orderDate", 
                        title: "Order Date", 
                        width: "120px",
                        template: "#= orderDate ? kendo.toString(kendo.parseDate(orderDate), 'yyyy-MM-dd') : '' #"
                    },
                    { 
                        field: "expectedDate", 
                        title: "Expected Date", 
                        width: "120px",
                        template: "#= expectedDate ? kendo.toString(kendo.parseDate(expectedDate), 'yyyy-MM-dd') : '' #"
                    },
                    { 
                        field: "totalAmount", 
                        title: "Total Amount", 
                        width: "140px",
                        template: "#= kendo.toString(totalAmount, 'n2') #"
                    },
                    {
                        field: "status",
                        title: "Status",
                        width: "120px",
                        template: function (dataItem) {
                            var badge = "secondary";
                            if (dataItem.status === "Approved") badge = "primary";
                            else if (dataItem.status === "Completed") badge = "success";
                            else if (dataItem.status === "PartiallyReceived") badge = "info";
                            else if (dataItem.status === "Cancelled") badge = "danger";
                            return `<span class='badge badge-${badge}'>${dataItem.status}</span>`;
                        }
                    }
                ]
            });
        });

        function deletePO(id) {
            if (confirm("Are you sure you want to delete this Purchase Order?")) {
                $.ajax({
                    url: '/PurchaseOrder/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            $('#POGrid').data('kendoGrid').dataSource.read();
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}

