@model DealerManagement.Model.Entities.PurchaseOrderMaster
@{
    var isUpdate = Model.Operation == "update";
    ViewData["Title"] = isUpdate ? "Edit Purchase Order" : "New Purchase Order";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = (isUpdate ? "Edit" : "Create") + " Purchase Order",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/PurchaseOrder", "Purchase Order"},
        {"", isUpdate ? "Edit" : "Create"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <button type="button" class="button btnSave @(isUpdate ? "sslUpdate" : "sslSave")" id="btnSavePO">
                <i class="fas fa-save mr-1"></i> @(isUpdate ? "Update" : "Save")
            </button>
            <a href="/PurchaseOrder/Index" class="btn btn-secondary btn-sm float-right ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Back to List
            </a>
            @if (isUpdate)
            {
                <a href="/PurchaseOrder/Create" class="button NewButton addNewButton float-right">
                    <i class="fas fa-plus mr-1"></i> New
                </a>
            }
        </div>
    </div>
</div>

<form id="frmPOMaster">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.PurchaseOrderID)
    @Html.HiddenFor(m => m.Operation)

    <div class="container-fluid">
        <!-- Master Form Card -->
        <div class="card card-secondary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-file-invoice mr-1"></i> Purchase Order Master</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 form-group">
                        @Html.LabelFor(m => m.PurchaseOrderNo) <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.PurchaseOrderNo, new { @class = "form-control form-control-sm", required = "required" })
                        @Html.ValidationMessageFor(m => m.PurchaseOrderNo, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3 form-group">
                        <label>Supplier <span class="text-danger">*</span></label>
                        <select id="SupplierID" name="SupplierID" class="form-control form-control-sm" data-selected="@Model.SupplierID" required>
                            <option value="">----- Select Supplier -----</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.SupplierID, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-2 form-group">
                        @Html.LabelFor(m => m.OrderDate) <span class="text-danger">*</span>
                        <input type="date" id="OrderDate" name="OrderDate" class="form-control form-control-sm" value="@Model.OrderDate.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="col-md-2 form-group">
                        @Html.LabelFor(m => m.ExpectedDate)
                        <input type="date" id="ExpectedDate" name="ExpectedDate" class="form-control form-control-sm" value="@(Model.ExpectedDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-md-2 form-group">
                        @Html.LabelFor(m => m.Status)
                        <select id="Status" name="Status" class="form-control form-control-sm">
                            <option value="Draft" selected="@(Model.Status == "Draft")">Draft</option>
                            <option value="Approved" selected="@(Model.Status == "Approved")">Approved</option>
                            <option value="PartiallyReceived" selected="@(Model.Status == "PartiallyReceived")">Partially Received</option>
                            <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 form-group mb-0">
                        @Html.LabelFor(m => m.Remarks)
                        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control form-control-sm", placeholder = "Additional notes / remarks" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Section Card -->
        <div class="card card-secondary">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title"><i class="fas fa-list-ol mr-1"></i> Order Items (Details)</h3>
                <button type="button" id="btnAddRow" class="btn btn-success btn-sm float-right">
                    <i class="fas fa-plus mr-1"></i> Add Item
                </button>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered table-striped table-sm mb-0" id="tblPODetails">
                    <thead class="bg-light">
                        <tr>
                            <th style="width: 32%;">Product / Item <span class="text-danger">*</span></th>
                            <th style="width: 12%; text-align: right;">Quantity <span class="text-danger">*</span></th>
                            <th style="width: 12%; text-align: right;">Unit Price <span class="text-danger">*</span></th>
                            <th style="width: 10%; text-align: right;">Discount</th>
                            <th style="width: 10%; text-align: right;">Tax</th>
                            <th style="width: 14%; text-align: right;">Line Total</th>
                            <th style="width: 6%; text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tblPODetailsBody">
                        @if (Model.DetailsList != null && Model.DetailsList.Any())
                        {
                            foreach (var line in Model.DetailsList)
                            {
                                <tr class="item-row">
                                    <td>
                                        <select class="form-control form-control-sm ddlProduct" required data-selected="@line.ProductID">
                                            <option value="">----- Select Product -----</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="any" min="0.001" class="form-control form-control-sm text-right txtQty" value="@line.Quantity" required />
                                    </td>
                                    <td>
                                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtPrice" value="@line.UnitPrice" required />
                                    </td>
                                    <td>
                                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtDiscount" value="@line.DiscountAmount" />
                                    </td>
                                    <td>
                                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtTax" value="@line.TaxAmount" />
                                    </td>
                                    <td>
                                        <input type="number" step="any" class="form-control form-control-sm text-right txtLineTotal bg-light" value="@line.LineTotal" readonly />
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-danger btn-sm btnRemoveRow" title="Remove"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="bg-light font-weight-bold">
                        <tr>
                            <td class="text-right">Grand Total:</td>
                            <td class="text-right"><span id="lblTotalQty">0.00</span></td>
                            <td></td>
                            <td class="text-right"><span id="lblTotalDiscount">0.00</span></td>
                            <td class="text-right"><span id="lblTotalTax">0.00</span></td>
                            <td class="text-right"><span id="lblGrandTotal">0.00</span></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/CommonComboLoader.js"></script>
    <script>
        var productListOptions = [];

        $(document).ready(function () {
            // Load Suppliers
            LoadCombo("SupplierID", '/Common/GetSuppliers');
            var selSup = $('#SupplierID').attr('data-selected');
            if (selSup && selSup > 0) {
                $('#SupplierID').val(selSup);
            }

            // Cache products list for row dropdowns
            $.ajax({
                url: '/Common/GetProducts',
                type: 'GET',
                async: false,
                success: function (data) {
                    productListOptions = data;
                }
            });

            // Populate existing rows
            $('#tblPODetailsBody tr').each(function () {
                var ddl = $(this).find('.ddlProduct');
                populateProductDropdown(ddl);
                var sel = ddl.attr('data-selected');
                if (sel && sel > 0) {
                    ddl.val(sel);
                }
            });

            // If empty (Add mode), add one initial row
            if ($('#tblPODetailsBody tr').length === 0) {
                addNewRow();
            }

            calculateTotals();

            // Event bindings
            $('#btnAddRow').click(function () {
                addNewRow();
            });

            $(document).on('click', '.btnRemoveRow', function () {
                if ($('#tblPODetailsBody tr').length > 1) {
                    $(this).closest('tr').remove();
                    calculateTotals();
                } else {
                    toastr.warning("At least one item line is required.");
                }
            });

            $(document).on('change', '.ddlProduct', function () {
                var row = $(this).closest('tr');
                var productId = $(this).val();
                if (productId && productId > 0) {
                    $.ajax({
                        url: '/Common/GetProductPrice?productId=' + productId + '&priceType=Purchase',
                        type: 'GET',
                        success: function (res) {
                            if (res && res.price) {
                                row.find('.txtPrice').val(res.price);
                            }
                            recalculateRow(row);
                        }
                    });
                }
            });

            $(document).on('input', '.txtQty, .txtPrice, .txtDiscount, .txtTax', function () {
                var row = $(this).closest('tr');
                recalculateRow(row);
            });

            // Save Master & Details together
            $('#btnSavePO').click(function () {
                var form = $('#frmPOMaster');
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }

                var details = [];
                var isValid = true;

                $('#tblPODetailsBody tr').each(function () {
                    var prodId = $(this).find('.ddlProduct').val();
                    var qty = parseFloat($(this).find('.txtQty').val()) || 0;
                    var price = parseFloat($(this).find('.txtPrice').val()) || 0;
                    var disc = parseFloat($(this).find('.txtDiscount').val()) || 0;
                    var tax = parseFloat($(this).find('.txtTax').val()) || 0;
                    var lineTot = parseFloat($(this).find('.txtLineTotal').val()) || 0;

                    if (!prodId || prodId <= 0) {
                        toastr.error("Please select a product for all item rows.");
                        isValid = false;
                        return false;
                    }

                    if (qty <= 0) {
                        toastr.error("Quantity must be greater than zero for all rows.");
                        isValid = false;
                        return false;
                    }

                    details.push({
                        ProductID: parseInt(prodId),
                        Quantity: qty,
                        UnitPrice: price,
                        DiscountAmount: disc,
                        TaxAmount: tax,
                        LineTotal: lineTot
                    });
                });

                if (!isValid) return;

                if (details.length === 0) {
                    toastr.error("Please add at least one item line.");
                    return;
                }

                var masterData = {
                    PurchaseOrderID: parseInt($('#PurchaseOrderID').val()) || 0,
                    PurchaseOrderNo: $('#PurchaseOrderNo').val(),
                    SupplierID: parseInt($('#SupplierID').val()),
                    OrderDate: $('#OrderDate').val(),
                    ExpectedDate: $('#ExpectedDate').val() || null,
                    Status: $('#Status').val(),
                    Remarks: $('#Remarks').val(),
                    Operation: $('#Operation').val(),
                    DetailsList: details
                };

                $.ajax({
                    url: '/PurchaseOrder/CreateEdit',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(masterData),
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            if ($('#Operation').val() === 'add' && res.data) {
                                $('#PurchaseOrderID').val(res.data.purchaseOrderID);
                                $('#Operation').val('update');
                                $('#btnSavePO').html('<i class="fas fa-save mr-1"></i> Update').removeClass('sslSave').addClass('sslUpdate');
                            }
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An unexpected error occurred while saving.");
                    }
                });
            });
        });

        function populateProductDropdown(ddl) {
            ddl.empty();
            ddl.append(new Option("----- Select Product -----", ""));
            $.each(productListOptions, function (i, item) {
                ddl.append(new Option(item.value, item.name));
            });
        }

        function addNewRow() {
            var tr = $(`
                <tr class="item-row">
                    <td>
                        <select class="form-control form-control-sm ddlProduct" required>
                            <option value="">----- Select Product -----</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" step="any" min="0.001" class="form-control form-control-sm text-right txtQty" value="1" required />
                    </td>
                    <td>
                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtPrice" value="0.00" required />
                    </td>
                    <td>
                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtDiscount" value="0.00" />
                    </td>
                    <td>
                        <input type="number" step="any" min="0" class="form-control form-control-sm text-right txtTax" value="0.00" />
                    </td>
                    <td>
                        <input type="number" step="any" class="form-control form-control-sm text-right txtLineTotal bg-light" value="0.00" readonly />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-danger btn-sm btnRemoveRow" title="Remove"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>
            `);

            populateProductDropdown(tr.find('.ddlProduct'));
            $('#tblPODetailsBody').append(tr);
            recalculateRow(tr);
        }

        function recalculateRow(row) {
            var qty = parseFloat(row.find('.txtQty').val()) || 0;
            var price = parseFloat(row.find('.txtPrice').val()) || 0;
            var disc = parseFloat(row.find('.txtDiscount').val()) || 0;
            var tax = parseFloat(row.find('.txtTax').val()) || 0;

            var lineTotal = (qty * price) - disc + tax;
            if (lineTotal < 0) lineTotal = 0;
            row.find('.txtLineTotal').val(lineTotal.toFixed(2));

            calculateTotals();
        }

        function calculateTotals() {
            var totalQty = 0;
            var totalDisc = 0;
            var totalTax = 0;
            var grandTotal = 0;

            $('#tblPODetailsBody tr').each(function () {
                totalQty += parseFloat($(this).find('.txtQty').val()) || 0;
                totalDisc += parseFloat($(this).find('.txtDiscount').val()) || 0;
                totalTax += parseFloat($(this).find('.txtTax').val()) || 0;
                grandTotal += parseFloat($(this).find('.txtLineTotal').val()) || 0;
            });

            $('#lblTotalQty').text(totalQty.toFixed(2));
            $('#lblTotalDiscount').text(totalDisc.toFixed(2));
            $('#lblTotalTax').text(totalTax.toFixed(2));
            $('#lblGrandTotal').text(grandTotal.toFixed(2));
        }
    </script>
}

