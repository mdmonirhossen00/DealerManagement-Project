@model DealerManagement.Model.Entities.CustomerOpeningBalance
@{
    var isUpdate = Model.Operation == "update";
    ViewData["Title"] = isUpdate ? "Edit Opening Balance" : "New Opening Balance";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = (isUpdate ? "Edit" : "Set") + " Dealer Opening Balance",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/CustomerOpeningBalance", "Opening Balance"},
        {"", isUpdate ? "Edit" : "Set"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <button type="button" class="button btnSave @(isUpdate ? "sslUpdate" : "sslSave")" id="btnSaveOpening">
                <i class="fas fa-save mr-1"></i> @(isUpdate ? "Update" : "Save")
            </button>
            <a href="/CustomerOpeningBalance/Index" class="btn btn-secondary btn-sm float-right ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Back to List
            </a>
            @if (isUpdate)
            {
                <a href="/CustomerOpeningBalance/Create" class="button NewButton addNewButton float-right">
                    <i class="fas fa-plus mr-1"></i> New
                </a>
            }
        </div>
    </div>
</div>

<form id="frmOpening">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CustomerOpeningBalanceID)
    @Html.HiddenFor(m => m.Operation)

    <div class="container-fluid">
        <div class="card card-secondary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-book-open mr-1"></i> Opening Balance Details</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label>Customer / Dealer <span class="text-danger">*</span></label>
                        <select id="CustomerID" name="CustomerID" class="form-control form-control-sm" data-selected="@Model.CustomerID" required>
                            <option value="">----- Select Customer -----</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.CustomerID, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.OpeningDate) <span class="text-danger">*</span>
                        <input type="date" id="OpeningDate" name="OpeningDate" class="form-control form-control-sm" value="@Model.OpeningDate.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="col-md-4 form-group">
                        @Html.LabelFor(m => m.BalanceAmount) <span class="text-danger">*</span>
                        @Html.TextBoxFor(m => m.BalanceAmount, new { @class = "form-control form-control-sm text-right", type = "number", step = "any", required = "required" })
                        @Html.ValidationMessageFor(m => m.BalanceAmount, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 form-group mb-0">
                        @Html.LabelFor(m => m.Remarks)
                        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control form-control-sm", placeholder = "Opening remarks, previous ledger reference" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/CommonComboLoader.js"></script>
    <script>
        $(document).ready(function () {
            LoadCombo("CustomerID", '/Common/GetCustomers');
            var selCust = $('#CustomerID').attr('data-selected');
            if (selCust && selCust > 0) {
                $('#CustomerID').val(selCust);
            }

            $('#btnSaveOpening').click(function () {
                var form = $('#frmOpening');
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }

                var model = {
                    CustomerOpeningBalanceID: parseInt($('#CustomerOpeningBalanceID').val()) || 0,
                    CustomerID: parseInt($('#CustomerID').val()),
                    OpeningDate: $('#OpeningDate').val(),
                    BalanceAmount: parseFloat($('#BalanceAmount').val()) || 0,
                    Remarks: $('#Remarks').val(),
                    Operation: $('#Operation').val()
                };

                $.ajax({
                    url: '/CustomerOpeningBalance/CreateEdit',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(model),
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            if ($('#Operation').val() === 'add' && res.data) {
                                $('#CustomerOpeningBalanceID').val(res.data.customerOpeningBalanceID);
                                $('#Operation').val('update');
                                $('#btnSaveOpening').html('<i class="fas fa-save mr-1"></i> Update').removeClass('sslSave').addClass('sslUpdate');
                            }
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while saving.");
                    }
                });
            });
        });
    </script>
}

