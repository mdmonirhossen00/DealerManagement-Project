@{
    ViewData["Title"] = "Supplier Opening Balance";
}

@Html.Partial("_Header", new DealerManagement.Model.Common.HeaderModel()
{
    HeaderName = "Supplier Opening Balance List",
    BreadCrums = new Dictionary<string, string>()
    {
        {"/SupplierOpeningBalance", "Supplier Opening Balance"},
        {"", "List"}
    }
})

<link href="~/css/button.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="card">
        <div class="card-header p-2">
            <a href="/SupplierOpeningBalance/Create" class="button NewButton addNewButton">
                <i class="fas fa-plus"></i> New Opening Balance
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card card-secondary">
        <div class="card-header">
            <h3 class="card-title">List Of Supplier Opening Balances</h3>
        </div>
        <div class="card-body">
            <div id="OpeningGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var gridDataSource = new kendo.data.DataSource({
                type: "json",
                serverPaging: true,
                serverSorting: true,
                serverFiltering: true,
                pageSize: 10,
                transport: {
                    read: {
                        url: "/SupplierOpeningBalance/GetGridData",
                        type: "POST",
                        dataType: "json"
                    }
                },
                schema: {
                    data: "items",
                    total: "totalCount",
                    model: {
                        id: "supplierOpeningBalanceID",
                        fields: {
                            supplierOpeningBalanceID: { type: "number" },
                            supplierName: { type: "string" },
                            openingDate: { type: "date" },
                            balanceAmount: { type: "number" },
                            remarks: { type: "string" }
                        }
                    }
                }
            });

            $("#OpeningGrid").kendoGrid({
                dataSource: gridDataSource,
                pageable: {
                    refresh: true,
                    pageSizes: [10, 20, 50, "all"],
                    buttonCount: 5
                },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        title: "Action",
                        width: "110px",
                        template: function (dataItem) {
                            return `<a href='/SupplierOpeningBalance/Edit/${dataItem.supplierOpeningBalanceID}' class='btn btn-primary btn-sm mr-1' title='Edit'>
                                        <i class='fas fa-pencil-alt'></i>
                                    </a>
                                    <button type='button' class='btn btn-danger btn-sm' onclick='deleteOpening(${dataItem.supplierOpeningBalanceID})' title='Delete'>
                                        <i class='fas fa-trash'></i>
                                    </button>`;
                        }
                    },
                    { field: "supplierName", title: "Supplier Name", width: "250px" },
                    { 
                        field: "openingDate", 
                        title: "Date", 
                        width: "140px",
                        template: "#= openingDate ? kendo.toString(kendo.parseDate(openingDate), 'yyyy-MM-dd') : '' #"
                    },
                    { 
                        field: "balanceAmount", 
                        title: "Opening Payable (Tk)", 
                        width: "180px",
                        template: "#= kendo.toString(balanceAmount, 'n2') #"
                    },
                    { field: "remarks", title: "Remarks", width: "300px" }
                ]
            });
        });

        function deleteOpening(id) {
            if (confirm("Are you sure you want to delete this Supplier Opening Balance?")) {
                $.ajax({
                    url: '/SupplierOpeningBalance/Delete/' + id,
                    type: 'POST',
                    success: function (res) {
                        if (res.status === "Success" || res.status === 200 || res.status === "200") {
                            toastr.success(res.message);
                            $('#OpeningGrid').data('kendoGrid').dataSource.read();
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}

