@model DealerManagement.Model.ViewModels.UserVM
@{
    ViewData["Title"] = "Create User";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-user-plus mr-2 text-primary"></i> Create User</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Home/Index">Home</a></li>
                    <li class="breadcrumb-item"><a href="/User/Index">Users</a></li>
                    <li class="breadcrumb-item active">Create</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-md-10 mx-auto">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">User Information</h3>
            </div>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 px-3 mb-3">
                            <i class="fas fa-exclamation-triangle mr-1"></i>
                            @Html.ValidationSummary(false, "")
                        </div>
                    }

                    <!-- Profile Picture Upload Section -->
                    <div class="row align-items-center mb-4 p-3 rounded" style="background-color: #f8f9fa; border: 1px dashed #ced4da;">
                        <div class="col-sm-3 text-center mb-2 mb-sm-0">
                            <div class="position-relative d-inline-block">
                                <img id="profilePicturePreview" 
                                     src="~/AdminLte/dist/img/avatar5.png" 
                                     alt="Profile Preview" 
                                     class="img-circle elevation-2" 
                                     style="width: 100px; height: 100px; object-fit: cover; border: 3px solid #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" />
                            </div>
                        </div>
                        <div class="col-sm-9">
                            <label class="font-weight-bold mb-1">
                                <i class="fas fa-camera mr-1 text-primary"></i> Profile Picture
                            </label>
                            <div class="custom-file">
                                <input type="file" name="profilePictureFile" id="profilePictureFile" class="custom-file-input" accept="image/jpeg,image/png,image/gif,image/webp" />
                                <label class="custom-file-label" for="profilePictureFile" id="profilePictureFileLabel">Choose photo...</label>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-1">
                                <small class="form-text text-muted">Allowed formats: JPG, PNG, GIF, WEBP (Max 5MB).</small>
                                <button type="button" class="btn btn-outline-danger btn-xs d-none" id="btnResetPicture">
                                    <i class="fas fa-times mr-1"></i> Remove
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="UserName">Username <span class="text-danger">*</span></label>
                            <input asp-for="UserName" class="form-control" placeholder="e.g. jdoe" required />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="FullName">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="Email">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="e.g. user@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="PhoneNumber">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. 01700000000" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="RoleID">Assign Role</label>
                            <select asp-for="RoleID" class="form-control">
                                <option value="">-- Select Role --</option>
                                @if (ViewBag.Roles != null)
                                {
                                    foreach (var role in (List<DealerManagement.Model.Common.DropdownModel>)ViewBag.Roles)
                                    {
                                        <option value="@role.Name" selected="@(Model.RoleID?.ToString() == role.Name)">@role.Value</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="RoleID" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="Password">Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Minimum 6 characters" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="ConfirmPassword">Confirm Password <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" asp-for="IsActive" class="custom-control-input" id="isActiveSwitch">
                            <label class="custom-control-label" for="isActiveSwitch">Active Account</label>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between">
                    <a href="/User/Index" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left mr-1"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-save mr-1"></i> Save User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var defaultAvatar = '/AdminLte/dist/img/avatar5.png';

            $('#profilePictureFile').on('change', function (e) {
                var file = this.files[0];
                if (file) {
                    if (file.size > 5 * 1024 * 1024) {
                        if (typeof toastr !== 'undefined') {
                            toastr.error('Profile picture file size cannot exceed 5 MB.');
                        } else {
                            alert('Profile picture file size cannot exceed 5 MB.');
                        }
                        this.value = '';
                        return;
                    }

                    $('#profilePictureFileLabel').text(file.name);

                    var reader = new FileReader();
                    reader.onload = function (event) {
                        $('#profilePicturePreview').attr('src', event.target.result);
                    };
                    reader.readAsDataURL(file);

                    $('#btnResetPicture').removeClass('d-none');
                }
            });

            $('#btnResetPicture').on('click', function () {
                $('#profilePictureFile').val('');
                $('#profilePictureFileLabel').text('Choose photo...');
                $('#profilePicturePreview').attr('src', defaultAvatar);
                $(this).addClass('d-none');
            });
        });
    </script>
}

